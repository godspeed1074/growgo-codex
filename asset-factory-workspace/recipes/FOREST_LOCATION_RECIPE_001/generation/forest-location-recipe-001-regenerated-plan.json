      ],
      "placementRule": "The main forest track remains traversable and readable while the surrounding vegetation mass increases in depth and enclosure."
    },
    {
      "zoneId": "CLEARING_OR_REST_ZONE",
      "purpose": "pause point, small clearing, or scenic turn-out within the forest walk",
      "allowedAssetRoles": [
