{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "growgo://asset-factory/LAYER_B_RECIPE_SCHEMA/1.0.0",
  "title": "GrowGo deterministic Layer B recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["recipeId", "recipeVersion", "layer", "recipeFamily", "components", "deterministicSeedRule", "provenance"],
  "properties": {
    "recipeId": { "type": "string", "pattern": "^GG-REC-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3,}$" },
    "recipeVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "layer": { "const": "LAYER_B_RECIPE" },
    "recipeFamily": { "type": "string" },
    "components": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["componentId", "assetId", "assetVersion", "transform"], "properties": { "componentId": { "type": "string" }, "assetId": { "type": "string" }, "assetVersion": { "type": "string" }, "transform": { "type": "object" }, "allowDeprecated": { "type": "boolean" } } } },
    "deterministicSeedRule": { "type": "string", "minLength": 1 },
    "provenance": { "type": "object" }
  }
}
