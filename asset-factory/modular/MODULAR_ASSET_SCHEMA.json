{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "growgo://asset-factory/MODULAR_ASSET_SCHEMA/1.0.0",
  "title": "GrowGo Layer A Modular Asset Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["assetId", "assetVersion", "layer", "category", "type", "family", "designSpecification", "dimensionsMeters", "geometryBudget", "textureBudget", "materialBudget", "exportedFileSizeBudget", "lod", "textureAtlases", "orientationRules", "variationRules", "allowedTransformations", "collisionRules", "deterministicGeneration", "modularReuse", "recipeCompatibility", "mobileBudgetProfile", "palette", "approvalState", "provenance", "tags"],
  "properties": {
    "assetId": { "type": "string", "pattern": "^GG-[A-Z0-9]+-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3,}$" },
    "assetVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "layer": { "const": "LAYER_A_MODULE" },
    "category": { "enum": ["BUILDING", "SCENERY", "VEGETATION", "RAILWAY", "TERRAIN", "VEHICLE", "LANDMARK", "ROAD_STREET_FURNITURE"] },
    "type": { "type": "string", "minLength": 1 },
    "family": { "type": "string", "minLength": 1 },
    "designSpecification": { "type": "object", "minProperties": 1 },
    "dimensionsMeters": { "type": "object", "required": ["width", "height", "depth"], "properties": { "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 }, "depth": { "type": "number", "exclusiveMinimum": 0 } } },
    "geometryBudget": { "type": "object", "required": ["preferredTriangles", "triangleCeiling", "vertexCeiling"] },
    "textureBudget": { "type": "object", "required": ["textureCount", "maxDimension"] },
    "materialBudget": { "type": "object", "required": ["materialCeiling", "materialIds"] },
    "exportedFileSizeBudget": { "type": "object", "required": ["targetBytes", "ceilingBytes"] },
    "lod": { "type": "object", "required": ["required", "available", "identityPreservation"] },
    "textureAtlases": { "type": "array", "items": { "type": "object", "required": ["textureAtlasId", "textureAtlasVersion", "uvRegion"] } },
    "orientationRules": { "type": "object" },
    "variationRules": { "type": "object" },
    "allowedTransformations": { "type": "array", "items": { "type": "object", "required": ["type"] } },
    "collisionRules": { "type": "object" },
    "deterministicGeneration": { "type": "object" },
    "modularReuse": { "type": "object" },
    "recipeCompatibility": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "mobileBudgetProfile": { "type": "string", "minLength": 1 },
    "palette": { "type": "object", "required": ["paletteFamily", "allowedPaletteIds", "deterministicPaletteRule"] },
    "approvalState": { "enum": ["DRAFT", "REVIEW", "APPROVED", "DEPRECATED", "SUPERSEDED"] },
    "provenance": { "type": "object" },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
